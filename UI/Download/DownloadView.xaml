<Window x:Class="Ark.UI.Download.DownloadView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:Ark.UI.Download"         
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:DownloadModel}" 
        FontSize="14"
        x:Name="DownloadView1" 
        Title="Скачивание" 
        Height="450" Width="800">
    <Window.Resources>
        <xctk:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding CancelCommand}"
                                   PassEventArgsToCommand="True"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Папка сохранения"
                   Grid.Row="0"
                   FontSize="12"
                   Margin="10,3,3,0"/>
        <Grid Grid.Row="1"
              IsEnabled="{Binding AllowChangeSettings}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding DownloadFolder}"
                     Margin="3,3,3,3"/>
            <Button Content="Обзор"
                    Grid.Column="1"
                    Width="100"
                    Command="{Binding ChooseDownloadFolderCommand}"
                    Margin="3,3,3,3"/>
        </Grid>
        <CheckBox Grid.Row="2"
                Margin="3,3,3,3"
                IsChecked="{Binding Overwrite}"
                IsEnabled="{Binding AllowChangeSettings}"
                VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center"
                        Margin="3,3,3,3"
                        Grid.Column="1">
                <Run Text="Перезаписать файлы на диске"/>
                <Run Text="(При перезаписи старые файлы будут утеряны!)"
                        Foreground="Red"/>
            </TextBlock>
        </CheckBox>
        <DataGrid ItemsControl.ItemsSource="{Binding Queue}" 
                    Margin="3,3,3,3" 
                    Grid.Row="4" 
                    CanUserAddRows="False"
                    CanUserSortColumns="False"
                    IsReadOnly="True"
                    AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Первоначальный путь" Binding="{Binding File.FullPath}"/>
                <DataGridTextColumn Header="Итоговый путь" Binding="{Binding Path}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                <DataGridTextColumn Header="Сообщение ошибки" Binding="{Binding Exception.Message}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="5"
              Margin="3,3,3,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>        
            <ProgressBar Grid.Column="0"
                         Height="25"
                         Margin="3,3,3,3"
                         Value="{Binding Progress}"
                         Maximum="{Binding MaxProgress}"/>
            <Button Grid.Column="1"
                    Width="90" Height="30"
                    Margin="3,3,3,3"
                    Content="Старт"
                    Command="{Binding DownloadCommand}"/>
            <Button x:Name="CancelButton" 
                    Grid.Column="2"
                    Width="90" Height="30"
                    Margin="3,3,3,3"
                    Content="Отмена"
                    Click="CancelButton_Click"
                    Visibility="{Binding Path=IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>
